# Copy this to .env.local for local dev only.
# NEVER create the real .env.local via GitHub's web UI - do it locally,
# or your keys get exposed and Supabase/GitHub will auto-revoke them.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
N8N_WEBHOOK_URL=https://your-n8n-host.example/webhook/lead-recovery
